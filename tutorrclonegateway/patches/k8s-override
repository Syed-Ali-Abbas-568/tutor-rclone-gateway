---
# NetworkPolicy has no dedicated Tutor core patch hook the way
# Deployments/Jobs/Services/Volumes do, so this lives under the generic
# k8s-override extension point instead. No tutor-rustfs equivalent:
# RustFS has no bucket whose security depends on only being reachable
# through Caddy, so it has never needed this. Both gateway Deployments
# do — rclonegw-public's --include/--read-only scoping (see
# local-docker-compose-services) is meant to be the *last* line of
# defense, not the only one, and ClusterIP alone (k8s-services) still
# leaves both Deployments reachable from any other pod in the cluster
# via Service DNS. Restrict ingress to the Caddy pod specifically.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: rclonegw
  labels:
    app.kubernetes.io/name: rclonegw
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: rclonegw
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: caddy
      ports:
        - port: 9000
          protocol: TCP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: rclonegw-public
  labels:
    app.kubernetes.io/name: rclonegw-public
spec:
  podSelector:
    matchLabels:
      app.kubernetes.io/name: rclonegw-public
  policyTypes:
    - Ingress
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app.kubernetes.io/name: caddy
      ports:
        - port: 9000
          protocol: TCP
